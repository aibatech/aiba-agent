# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AIBA_API_TOKEN=
AIBA_MASTER_KEY=
AIBA_API_HOST=127.0.0.1
AIBA_API_PORT=8765
AIBA_ALLOWED_ORIGINS=
AIBA_RATE_LIMIT_PER_MINUTE=60

# local | openai | anthropic | openai_compatible | ollama
AIBA_PROVIDER=local
AIBA_MODEL=gpt-4.1-mini
AIBA_FALLBACK_PROVIDER=local
AIBA_FALLBACK_MODEL=local-v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
PERPLEXITY_API_KEY=
AZURE_OPENAI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

AIBA_SANDBOX_MODE=local
AIBA_REQUIRE_APPROVAL=true
AIBA_SANDBOX_NETWORK=false
AIBA_WORKER_ENABLED=true
AIBA_BROWSER_ENABLED=false
AIBA_DESKTOP_ENABLED=false

# Native automatic updates use a small HTTPS JSON manifest. Docker users update
# by pulling/rebuilding the image so the container remains immutable.
AIBA_UPDATE_MANIFEST_URL=
AIBA_AUTO_UPDATE=true
AIBA_UPDATE_INTERVAL_SECONDS=86400

# Set these to a published GitHub Release ZIP and its SHA-256 to activate
# downloadable VPS cloud-init from the dashboard.
AIBA_RELEASE_URL=
AIBA_RELEASE_SHA256=

# Telegram Bot API. Long polling works from a computer behind a home router.
AIBA_TELEGRAM_ENABLED=false
AIBA_TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram owner IDs. Required when enabled.
AIBA_TELEGRAM_ALLOWED_USERS=

# Official Meta WhatsApp Cloud API. Requires an HTTPS webhook that routes to:
# /v1/connectors/whatsapp/webhook
AIBA_WHATSAPP_ENABLED=false
AIBA_WHATSAPP_ACCESS_TOKEN=
AIBA_WHATSAPP_PHONE_NUMBER_ID=
AIBA_WHATSAPP_VERIFY_TOKEN=
AIBA_WHATSAPP_APP_SECRET=
# Comma-separated owner phone numbers with country code, digits only.
AIBA_WHATSAPP_ALLOWED_NUMBERS=
AIBA_WHATSAPP_GRAPH_VERSION=v23.0
